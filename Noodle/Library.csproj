    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Noodle.Core</AssemblyName>
    <RootNamespace>Noodle.Core</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
