<UserControl x:Class="Noodle.App.Views.DropView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             Drop="OnDrop"
             DragEnter="OnDragEnter"
             DragLeave="OnDragLeave"
             DragOver="OnDragOver"
             Background="{DynamicResource Br.BgApp}">

    <Grid>
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="480">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Drop zone -->
            <Grid Grid.Row="0" Height="320">
                <Rectangle x:Name="DropRect"
                           Stroke="{DynamicResource Br.DropBorder}"
                           StrokeDashArray="4,3"
                           StrokeThickness="1"
                           Fill="{DynamicResource Br.DropBg}"
                           RadiusX="6" RadiusY="6"/>

                <!-- Idle state -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="{Binding IsAnalyzing, Converter={StaticResource InvBoolToVis}}">

                    <TextBlock Text="&#xE896;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="48"
                               Foreground="{DynamicResource Br.Accent}"
                               HorizontalAlignment="Center"
                               Opacity="0.4"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="{Binding StatusText}"
                               FontFamily="Consolas, Courier New"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Br.Accent}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>

                    <TextBlock Text="// drag a file here, or browse below"
                               FontFamily="Consolas, Courier New"
                               FontSize="10"
                               Foreground="{DynamicResource Br.Text.Secondary}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <Button Content="&gt; BROWSE FILE"
                            Style="{StaticResource Btn.Ghost}"
                            Command="{Binding BrowseFileCommand}"
                            HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Scanning state — live step log -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Width="380"
                            Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}">

                    <!-- Animated scan bar -->
                    <ProgressBar IsIndeterminate="True"
                                 Width="360" Height="2"
                                 Background="Transparent"
                                 Foreground="{DynamicResource Br.Accent}"
                                 BorderThickness="0"
                                 Margin="0,0,0,20"/>

                    <!-- Step text — monospace terminal feel -->
                    <TextBlock Text="{Binding StatusText}"
                               FontFamily="Consolas, Courier New"
                               FontSize="11"
                               Foreground="{DynamicResource Br.Accent}"
                               HorizontalAlignment="Left"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <!-- Error panel -->
            <Border Grid.Row="2"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource Br.DangerBg}"
                    BorderBrush="{DynamicResource Br.Danger}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="14,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="[ERR]"
                               FontFamily="Consolas, Courier New"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Br.Danger}"
                               VerticalAlignment="Top"
                               Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding ErrorText}"
                               Foreground="{DynamicResource Br.Danger}"
                               FontFamily="Consolas, Courier New"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
