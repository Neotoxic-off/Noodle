<UserControl x:Class="Noodle.App.Views.DropView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             Drop="OnDrop"
             DragEnter="OnDragEnter"
             DragLeave="OnDragLeave"
             DragOver="OnDragOver"
             Background="{DynamicResource Br.BgApp}">

    <UserControl.Resources>
        <Style x:Key="ScanProgressBar" TargetType="ProgressBar">
            <Setter Property="Height"          Value="2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="{DynamicResource Br.BgElevated}"/>
            <Setter Property="Foreground"      Value="{DynamicResource Br.Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="1"
                                    Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Indicator" CornerRadius="1"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" Margin="60,0" MinHeight="220">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Drop rectangle -->
            <Grid Grid.Row="0" MinHeight="220">
                <Rectangle x:Name="DropRect"
                           Stroke="{DynamicResource Br.DropBorder}"
                           StrokeDashArray="4,3"
                           StrokeThickness="1"
                           Fill="{DynamicResource Br.DropBg}"
                           RadiusX="6" RadiusY="6"/>

                <!-- Idle state -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="{Binding IsAnalyzing, Converter={StaticResource InvBoolToVis}}">

                    <TextBlock Text="&#xE896;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="48"
                               Foreground="{DynamicResource Br.Accent}"
                               HorizontalAlignment="Center"
                               Opacity="0.35"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="{Binding StatusText}"
                               FontFamily="Consolas, Courier New"
                               FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource Br.Accent}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>

                    <TextBlock Text="// drag a file here, or browse below"
                               FontFamily="Consolas, Courier New"
                               FontSize="10"
                               Foreground="{DynamicResource Br.Text.Secondary}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <Button Content="&gt; BROWSE FILE"
                            Style="{StaticResource Btn.Ghost}"
                            Command="{Binding BrowseFileCommand}"
                            HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Scanning state -->
                <Grid VerticalAlignment="Center"
                      Margin="32,0"
                      Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}">

                    <StackPanel>
                        <!-- Overall progress -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding StatusText}"
                                       FontFamily="Consolas, Courier New"
                                       FontSize="11"
                                       Foreground="{DynamicResource Br.Accent}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ScanProgress, StringFormat={}{0:F0}%}"
                                       FontFamily="Consolas, Courier New"
                                       FontSize="10"
                                       Foreground="{DynamicResource Br.Text.Secondary}"/>
                        </Grid>
                        <ProgressBar Style="{StaticResource ScanProgressBar}"
                                     Value="{Binding ScanProgress, Mode=OneWay}"
                                     Maximum="100"
                                     Margin="0,0,0,12"/>

                        <!-- Sub-task progress (YARA rules, etc.) -->
                        <Grid Margin="0,0,0,6"
                              Visibility="{Binding HasSubProgress, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="rules"
                                       FontFamily="Consolas, Courier New"
                                       FontSize="10"
                                       Foreground="{DynamicResource Br.Text.Secondary}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SubStatusText}"
                                       FontFamily="Consolas, Courier New"
                                       FontSize="10"
                                       Foreground="{DynamicResource Br.Text.Secondary}"/>
                        </Grid>
                        <ProgressBar Style="{StaticResource ScanProgressBar}"
                                     Value="{Binding SubScanProgress, Mode=OneWay}"
                                     Maximum="100"
                                     Visibility="{Binding HasSubProgress, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Error panel -->
            <Border Grid.Row="2"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource Br.DangerBg}"
                    BorderBrush="{DynamicResource Br.Danger}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="14,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="[ERR]"
                               FontFamily="Consolas, Courier New"
                               FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource Br.Danger}"
                               VerticalAlignment="Top"
                               Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding ErrorText}"
                               Foreground="{DynamicResource Br.Danger}"
                               FontFamily="Consolas, Courier New"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
