<UserControl x:Class="Noodle.App.Views.DropView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             Drop="OnDrop"
             DragEnter="OnDragEnter"
             DragLeave="OnDragLeave"
             DragOver="OnDragOver"
             Background="{DynamicResource Br.BgApp}">

    <Grid>
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="460">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Drop zone -->
            <Grid Grid.Row="0" Height="300">
                <!-- Dashed border via Rectangle -->
                <Rectangle x:Name="DropRect"
                           Stroke="{DynamicResource Br.DropBorder}"
                           StrokeDashArray="6,4"
                           StrokeThickness="2"
                           Fill="{DynamicResource Br.DropBg}"
                           RadiusX="20" RadiusY="20"/>

                <!-- Normal state -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="{Binding IsAnalyzing, Converter={StaticResource InvBoolToVis}}">

                    <TextBlock Text="&#xE896;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="52"
                               Foreground="{DynamicResource Br.Text.Tertiary}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>

                    <TextBlock Text="{Binding StatusText}"
                               Style="{StaticResource Text.Subheading}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="or"
                               Style="{StaticResource Text.Secondary}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,14"/>

                    <Button Content="Browse File"
                            Style="{StaticResource Btn.Primary}"
                            Command="{Binding BrowseFileCommand}"
                            HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Analyzing state -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}">

                    <ProgressBar IsIndeterminate="True"
                                 Width="220" Height="4"
                                 Background="{DynamicResource Br.BgElevated}"
                                 Foreground="{DynamicResource Br.Accent}"
                                 BorderThickness="0"
                                 Margin="0,0,0,16"/>

                    <TextBlock Text="{Binding StatusText}"
                               Style="{StaticResource Text.Body}"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource Br.Text.Secondary}"/>
                </StackPanel>
            </Grid>

            <!-- Error panel -->
            <Border Grid.Row="2"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource Br.DangerBg}"
                    BorderBrush="{DynamicResource Br.Danger}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE783;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{DynamicResource Br.Danger}"
                               VerticalAlignment="Top"
                               Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding ErrorText}"
                               Foreground="{DynamicResource Br.Danger}"
                               Style="{StaticResource Text.Body}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
