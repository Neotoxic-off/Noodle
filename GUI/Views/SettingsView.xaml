<UserControl x:Class="Noodle.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Br.BgApp}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,32">

            <TextBlock Text="Settings" Style="{StaticResource Text.Heading}" Margin="0,0,0,24"/>

            <!-- ─── Appearance ─── -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource Text.Subheading}" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Dark Theme" Style="{StaticResource Text.Body}"/>
                            <TextBlock Text="Switch between dark and light appearance."
                                       Style="{StaticResource Text.Secondary}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding IsDarkTheme}"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ─── About ─── -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource Text.Subheading}" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Application"
                                   Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Noodle — PE File Analyzer"
                                   Style="{StaticResource Text.Body}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Version"
                                   Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{Binding Version}"
                                   Style="{StaticResource Text.Code}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Description"
                                   Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1"
                                   Text="Analyzes PE binaries for packed sections, suspicious imports, hardcoded IOCs, and YARA rule matches."
                                   Style="{StaticResource Text.Secondary}"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
