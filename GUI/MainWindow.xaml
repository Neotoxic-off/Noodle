<Window x:Class="Noodle.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Noodle"
        Width="1060" Height="700"
        MinWidth="820" MinHeight="540"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Br.BgApp}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ─── Title bar ─── -->
        <Border Grid.Row="0"
                Background="{DynamicResource Br.TitleBar}"
                MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Noodle"
                           Style="{StaticResource Text.Body}"
                           VerticalAlignment="Center"
                           Margin="16,0"
                           Foreground="{DynamicResource Br.Text.Secondary}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource Btn.Chrome}"
                            FontFamily="Segoe MDL2 Assets"
                            Content="&#xE921;"
                            Click="OnMinimize"/>
                    <Button Style="{StaticResource Btn.Chrome}"
                            FontFamily="Segoe MDL2 Assets"
                            Content="&#xE922;"
                            Click="OnMaximize"/>
                    <Button Style="{StaticResource Btn.Chrome.Close}"
                            FontFamily="Segoe MDL2 Assets"
                            Content="&#xE8BB;"
                            Click="OnClose"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ─── Body ─── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Br.BgSidebar}"
                    BorderBrush="{DynamicResource Br.Separator}"
                    BorderThickness="0,0,1,0">
                <StackPanel Margin="0,16,0,0">

                    <TextBlock Text="Noodle"
                               Style="{StaticResource Text.Heading}"
                               Margin="20,0,0,24"/>

                    <!-- Home nav -->
                    <Button Style="{StaticResource Btn.Nav}"
                            Command="{Binding GoHomeCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Text="&#xE896;"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Br.NavIcon.Inactive}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHomeActive}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Br.NavIcon.Active}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Analyze" Style="{StaticResource Text.Body}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Settings nav -->
                    <Button Style="{StaticResource Btn.Nav}"
                            Command="{Binding GoSettingsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Text="&#xE713;"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Br.NavIcon.Inactive}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSettingsActive}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Br.NavIcon.Active}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Settings" Style="{StaticResource Text.Body}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Border>

            <!-- Content area — DataTemplate resolves VM → View -->
            <ContentControl Grid.Column="1"
                            Content="{Binding CurrentPage}"
                            Focusable="False"/>
        </Grid>
    </Grid>
</Window>
