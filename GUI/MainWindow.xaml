<Window x:Class="Noodle.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Noodle"
        Width="900" Height="700"
        MinWidth="640" MinHeight="480"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource Br.BgApp}">

    <!-- DWM rounded corners are applied in code-behind via OnSourceInitialized -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="4,4,4,4"
                            UseAeroCaptionButtons="False"
                            CornerRadius="10"/>
    </shell:WindowChrome.WindowChrome>

    <!-- Clip content to rounded corners -->
    <Border CornerRadius="10" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ─── Title bar ─── -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Br.TitleBar}"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="NOODLE // PE ANALYZER"
                               FontFamily="Consolas, Courier New"
                               FontSize="11"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="16,0"
                               Foreground="{DynamicResource Br.Accent}"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource Btn.Chrome}"
                                FontFamily="Segoe MDL2 Assets"
                                Content="&#xE921;"
                                Click="OnMinimize"/>
                        <Button Style="{StaticResource Btn.Chrome}"
                                FontFamily="Segoe MDL2 Assets"
                                Content="&#xE922;"
                                Click="OnMaximize"/>
                        <Button Style="{StaticResource Btn.Chrome.Close}"
                                FontFamily="Segoe MDL2 Assets"
                                Content="&#xE8BB;"
                                Click="OnClose"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ─── Content (full width, no sidebar) ─── -->
            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentPage}"
                            Focusable="False"/>
        </Grid>
    </Border>
</Window>
