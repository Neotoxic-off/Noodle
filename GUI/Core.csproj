<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>Noodle.App</AssemblyName>
    <RootNamespace>Noodle.App</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup>
    <LibrarySrcDll>$(MSBuildThisFileDirectory)..\Noodle\bin\$(Configuration)\net10.0-windows\Noodle.Core.dll</LibrarySrcDll>
    <!-- Stable copy in a sibling folder — never cleaned by MSBuild. -->
    <LibraryRefDll>$(MSBuildThisFileDirectory)..\build-refs\$(Configuration)\Noodle.Core.dll</LibraryRefDll>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <!--
      Library.csproj uses a manual Reference (not ProjectReference) to avoid the WPF BAML
      race condition, so transitive NuGet deps from Library never reach the GUI output.
      Declare them here as runtime-only so their DLLs are copied without polluting the
      GUI compile surface.
    -->
    <PackageReference Include="PeNet" Version="6.0.0">
      <IncludeAssets>runtime</IncludeAssets>
      <ExcludeAssets>compile;build;native;contentfiles;analyzers;buildtransitive</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Iced" Version="1.21.0">
      <IncludeAssets>runtime</IncludeAssets>
      <ExcludeAssets>compile;build;native;contentfiles;analyzers;buildtransitive</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Build Library but do not auto-reference its output (we manage that explicitly). -->
  <ItemGroup>
    <ProjectReference Include="..\Noodle\Library.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- Reference the stable copy in our own refs/ subfolder. -->
  <ItemGroup>
    <Reference Include="Noodle.Core">
      <HintPath>$(LibraryRefDll)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!--
    1. Build Library (if needed).
    2. Copy its DLL into our obj/refs/ subfolder — a location the WPF BAML temp project
       will not clean — so it is always available for MarkupCompilePass1 and CoreCompile.
  -->
  <ItemGroup>
    <Content Include="YaraRules\**\*.yar">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="YaraRules\**\*.yara">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="EnsureLibraryRef" BeforeTargets="MarkupCompilePass1;ResolveAssemblyReferences">
    <MSBuild Projects="..\Noodle\Library.csproj" Targets="Build" BuildInParallel="false" Properties="Configuration=$(Configuration)" />
    <Message Text="EnsureLibraryRef: src=$(LibrarySrcDll) exists=$([System.IO.File]::Exists('$(LibrarySrcDll)'))" Importance="High" />
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(LibraryRefDll)'))" />
    <Copy SourceFiles="$(LibrarySrcDll)" DestinationFiles="$(LibraryRefDll)" SkipUnchangedFiles="true" />
    <Message Text="EnsureLibraryRef: copied to $(LibraryRefDll)" Importance="High" />
  </Target>

</Project>
