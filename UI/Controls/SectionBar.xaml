<UserControl
    x:Class="Noodle.UI.Controls.SectionBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Height="36" Margin="0,1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="80"/>
        </Grid.ColumnDefinitions>

        <!-- Section name -->
        <TextBlock Grid.Column="0"
                   Text="{Binding SectionName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Foreground="{DynamicResource Br.Text.Primary}"
                   FontFamily="Cascadia Mono, Consolas, Courier New"
                   FontSize="12"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>

        <!-- Entropy bar -->
        <Border Grid.Column="1" VerticalAlignment="Center"
                Height="6" CornerRadius="3"
                Background="{DynamicResource Br.BgElevated}"
                Margin="0,0,12,0">
            <Grid>
                <Border x:Name="EntropyFill"
                        HorizontalAlignment="Left"
                        Width="{Binding EntropyBarWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Height="6" CornerRadius="3"
                        Background="{Binding EntropyBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </Grid>
        </Border>

        <!-- Entropy value -->
        <TextBlock Grid.Column="2"
                   Text="{Binding EntropyText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Foreground="{Binding EntropyBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   FontFamily="Cascadia Mono, Consolas, Courier New"
                   FontSize="12"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   Margin="0,0,12,0"/>

        <!-- Flags -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="ExecBadge"
                    Background="{DynamicResource Br.WarningBg}"
                    BorderBrush="{DynamicResource Br.Warning}"
                    BorderThickness="1" CornerRadius="4"
                    Padding="5,2" Margin="0,0,4,0"
                    Visibility="{Binding ExecVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <TextBlock Text="X" FontSize="9" FontWeight="Bold"
                           Foreground="{DynamicResource Br.Warning}"/>
            </Border>
            <Border x:Name="WriteBadge"
                    Background="{DynamicResource Br.InfoBg}"
                    BorderBrush="{DynamicResource Br.Info}"
                    BorderThickness="1" CornerRadius="4"
                    Padding="5,2"
                    Visibility="{Binding WriteVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <TextBlock Text="W" FontSize="9" FontWeight="Bold"
                           Foreground="{DynamicResource Br.Info}"/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
